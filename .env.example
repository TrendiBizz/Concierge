# Copy to .env, or run: scripts/gen-env.sh   (fills in random secrets for you)
# Use hex/alphanumeric secrets only (they are embedded in connection URLs).

# ---- Domain & Portal URLs -----------------------------------------------
# Local testing: localhost.  Production: your real domain.
DOMAIN=localhost
PUBLIC_BASE_URL=https://api.localhost
OWNER_PORTAL_URL=https://concierge.trendibizz.com/studio/
ONBOARDING_URL=
TRACKED_LINKS_BASE=

# ---- Database & Core Secrets (generated by scripts/gen-env.sh) ----------
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/concierge
POSTGRES_PASSWORD=
ADMIN_TOKEN=

# ---- Billing & Webhooks (optional) --------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BREVO_WEBHOOK_SECRET=

# ---- Inbound Email & Cloudflare Routing (optional) ----------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
INBOUND_CLOUDFLARE_SECRET=

# ---- Web Push (optional) ------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- AI providers --------------------------------------------------------
# Google Gemini key powers website voice (Gemini 3.8 Live), telephone voice bridge,
# and acts as the default OpenAI-compatible text chat fallback when LLM_API_KEY is blank.
GEMINI_API_KEY=

# Text model used for the chat widget and tool calls (OpenAI-compatible endpoint).
CHAT_MODEL=gemini-3.8-flash
# N3 failover (optional): any OpenAI-compatible provider that supports tool calls. All three needed.
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=
# N3 voicemail fallback: spool dir the PBX writes to when the AI voice link is down (empty = off).
# VOICEMAIL_SPOOL_DIR=

# Optional: use a different OpenAI-compatible provider for TEXT chat only
# (voice uses Google Gemini 3.8 Live).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=

# Voice: Google Gemini 3.8 Live (website voice + telephone Asterisk bridge).
VOICE_DEFAULT=Aoede
GEMINI_LIVE_MODEL=models/gemini-3.8-live
GEMINI_LIVE_WS_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent
GEMINI_AUTH_TOKENS_URL=https://generativelanguage.googleapis.com/v1alpha/auth_tokens
GEMINI_CONSTRAINED_WS_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1alpha.GenerativeService.BidiGenerateContentConstrained
GEMINI_LIVE_VOICE=Aoede
# Leave blank for models/gemini-3.8-live (which rejects thinkingLevel with WS 1007); opt-in for extended-thinking models.
GEMINI_THINKING_LEVEL=

# Optional cellular/PBX calls via Asterisk AudioSocket + Google Gemini 3.8 Live. Website voice does NOT need these.
# Production reads /opt/trendi/shared/api.env (raw env_file), not this file.
PHONE_RECEPTIONIST_ENABLED=false
PHONE_VOICE_PROVIDER=gemini_live
# Also requires tenants.phone_enabled=true, an enabled phone_numbers row owned by
# that tenant, and its telephone authorization. See scripts/vps/PHONE_SETUP.md.
# Populate only after a genuine incoming carrier call + delivery test succeeds.
PHONE_VERIFIED_TENANTS=

# ---- LM Studio (local model for TEXT chat) - optional ----------------------
# To use it: LLM_BASE_URL=http://host.containers.internal:1234/v1  LLM_API_KEY=lm-studio
#            CHAT_MODEL=<LMSTUDIO_IDENTIFIER below>
LMSTUDIO_MODEL_PATH=
LMSTUDIO_IDENTIFIER=concierge
LMSTUDIO_CONTEXT=8192
LMSTUDIO_GPU=max
LMSTUDIO_PORT=1234

# ---- SMS (Trendi own gateway / paired phone) - optional -------------------
# Without these, texts are skipped (never failed). Needed for: speed-to-lead texts,
# appointment reminders, review requests and two-way SMS conversations.
# Trendi's own SMS system: smsgate by default; tenant sms_transport=device uses a paired phone.
# Both are primary transports for new and existing tenants. Hero is voicemail only.
# Providers: smsgate | none
SMS_PROVIDER=smsgate
# Self-hosted Android gateway: a phone with a local SIM running capcom6/android-sms-gateway
# (Apache-2.0). Set SMS_PROVIDER=smsgate and fill these. Point the app's sms:received webhook at
#   https://<your-api>/api/v1/smsgate/<tenant public key>
SMSGATE_BASE_URL=
SMSGATE_SEND_PATH=/3rdparty/v1/messages
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_SIGNING_KEY=
SMSGATE_SIM_NUMBER=0
DEFAULT_COUNTRY_CODE=1

# ---- Email (any SMTP: Brevo / Resend / your own) - optional ----------------
# Needed for: owner alerts and email reminders.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# ---- Reactivation campaigns - optional ------------------------------------
# Campaigns are OFF per client until tenants.campaigns_enabled is switched on, and only reach leads
# with recorded MARKETING consent. Email campaigns need a signing secret for unsubscribe links
# (falls back to ADMIN_TOKEN). Unsubscribe links must be publicly reachable: allow
# /api/v1/unsubscribe/<token> through your tunnel / reverse proxy.
UNSUBSCRIBE_SECRET=
CAMPAIGN_MAX_RECIPIENTS=200
CAMPAIGN_COOLDOWN_DAYS=30
CAMPAIGN_EMAIL_PER_HOUR=60
CAMPAIGN_SMS_PER_HOUR=20

# ---- Runtime timezone ---------------------------------------------------
TZ=UTC

# Caller opt-in recording. NEVER enable without provider/legal approval and real-call QA.
PHONE_RECORDING_ENABLED=false

# ---- Rust social OAuth / customer account linking (optional; OFF by default) ---
# Set service secrets in a private secret store, never in this tracked example.
SOCIAL_SERVICE_ENABLED=false
SOCIAL_SERVICE_URL=http://127.0.0.1:4390
SOCIAL_CONCIERGE_KEY=
SOCIAL_AGENT_KEY=
SOCIAL_VAULT_KEY=
SOCIAL_DB=
SOCIAL_BIND=127.0.0.1:4390
SOCIAL_META_GRAPH_VERSION=v27.0
# Trendi Concierge Social uses Instagram Graph API with Facebook Login (linked Pages).
SOCIAL_INSTAGRAM_LOGIN_MODE=facebook
# Existing Trendi Meta developer application: Trendi Concierge Social (Development mode until Meta review).
# Public app ID; use the separate Instagram App ID if Instagram Login provides one.
SOCIAL_FACEBOOK_CLIENT_ID=676274422041376
SOCIAL_FACEBOOK_CLIENT_SECRET=
SOCIAL_FACEBOOK_CALLBACK=https://concierge.trendibizz.com/owner/social/oauth/callback
SOCIAL_INSTAGRAM_CLIENT_ID=
SOCIAL_INSTAGRAM_CLIENT_SECRET=
SOCIAL_INSTAGRAM_CALLBACK=
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_GOOGLE_CALLBACK=
SOCIAL_LINKEDIN_CLIENT_ID=
SOCIAL_LINKEDIN_CLIENT_SECRET=
SOCIAL_LINKEDIN_CALLBACK=
SOCIAL_MASTODON_ORIGIN=
SOCIAL_MASTODON_CLIENT_ID=
SOCIAL_MASTODON_CLIENT_SECRET=
SOCIAL_MASTODON_CALLBACK=
SOCIAL_ENABLE_PUBLISH=false
SOCIAL_ENABLE_GOOGLE_BUSINESS_PUBLISH=false
SOCIAL_ENABLE_FACEBOOK_PUBLISH=false
SOCIAL_ENABLE_INSTAGRAM_PUBLISH=false
SOCIAL_ENABLE_LINKEDIN_PUBLISH=false
SOCIAL_ENABLE_MASTODON_PUBLISH=false
