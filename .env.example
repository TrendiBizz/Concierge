# Copy to .env, or run: scripts/gen-env.sh   (fills in random secrets for you)
# Use hex/alphanumeric secrets only (they are embedded in connection URLs).

# ---- Domain -------------------------------------------------------------
# Local testing: localhost.  Production: your real domain (DNS A records for
# api. n8n. crm. chat. status. subdomains pointing at this server).
DOMAIN=localhost
PUBLIC_BASE_URL=https://api.localhost

# ---- Which optional services to run ------------------------------------
# automation=n8n  support=chatwoot  crm=twenty  ops=uptime-kuma
COMPOSE_PROFILES=automation,ops

# ---- Secrets (generated by scripts/gen-env.sh) -------------------------
POSTGRES_PASSWORD=
ADMIN_TOKEN=
N8N_ENCRYPTION_KEY=
CHATWOOT_SECRET_KEY_BASE=
TWENTY_APP_SECRET=

# ---- AI providers --------------------------------------------------------
# One xAI key powers both text chat (OpenAI-compatible API) and Grok Voice.
XAI_API_KEY=

# Text model used for the chat widget and tool calls. Check the xAI console
# for the model names available on your account and set the one you want.
CHAT_MODEL=grok-4

# Optional: use a different OpenAI-compatible provider for TEXT chat only
# (voice always uses xAI). Leave blank to use xAI.
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=

# Voice: leave VOICE_MODEL blank to use the API default, or set e.g. grok-voice-3.0
VOICE_MODEL=
VOICE_DEFAULT=eve

# ---- LM Studio (local model for TEXT chat) - optional ----------------------
# Easiest: run scripts/configure-lmstudio.sh, which fills these in for you.
# To use it: LLM_BASE_URL=http://host.docker.internal:1234/v1  LLM_API_KEY=lm-studio
#            CHAT_MODEL=<LMSTUDIO_IDENTIFIER below>
# Used by scripts/start-concierge.sh (the LM Studio part is skipped by docker compose itself):
LMSTUDIO_MODEL_PATH=
LMSTUDIO_IDENTIFIER=concierge
LMSTUDIO_CONTEXT=8192
LMSTUDIO_GPU=max
LMSTUDIO_PORT=1234

# ---- SMS (Twilio) - optional ---------------------------------------------
# Without these, texts are skipped (never failed). Needed for: speed-to-lead texts,
# appointment reminders, review requests and two-way SMS conversations.
# Which provider sends texts: twilio | smsgate | none
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# For a short code or a pool of senders (New Zealand operators prefer a short code): set this
# and Twilio sends through the Messaging Service instead of TWILIO_FROM_NUMBER.
TWILIO_MESSAGING_SERVICE_SID=
# Self-hosted alternative: an Android phone with a local SIM running capcom6/android-sms-gateway
# (Apache-2.0). Set SMS_PROVIDER=smsgate and fill these. Point the app's sms:received webhook at
#   https://<your-api>/api/v1/smsgate/<tenant public key>
SMSGATE_BASE_URL=
SMSGATE_SEND_PATH=/3rdparty/v1/messages
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_SIGNING_KEY=
SMSGATE_SIM_NUMBER=0
DEFAULT_COUNTRY_CODE=1

# ---- Email (any SMTP: Brevo / Resend / your own) - optional ----------------
# Needed for: owner alerts and email reminders.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# ---- Reactivation campaigns - optional ------------------------------------
# Campaigns are OFF per client until tenants.campaigns_enabled is switched on, and only reach leads
# with recorded MARKETING consent. Email campaigns need a signing secret for unsubscribe links
# (falls back to ADMIN_TOKEN). Unsubscribe links must be publicly reachable: allow
# /api/v1/unsubscribe/<token> through your tunnel / reverse proxy.
UNSUBSCRIBE_SECRET=
CAMPAIGN_MAX_RECIPIENTS=200
CAMPAIGN_COOLDOWN_DAYS=30
CAMPAIGN_EMAIL_PER_HOUR=60
CAMPAIGN_SMS_PER_HOUR=20

# ---- Pinned image tags (optional; pin these once everything works) ------
N8N_TAG=latest
CHATWOOT_TAG=latest
TWENTY_TAG=latest
TZ=UTC

# Caller opt-in recording. NEVER enable without provider/legal approval and real-call QA.
PHONE_RECORDING_ENABLED=false

# ---- Rust social OAuth / customer account linking (optional; OFF by default) ---
# Set service secrets in a private secret store, never in this tracked example.
SOCIAL_SERVICE_ENABLED=false
SOCIAL_SERVICE_URL=http://127.0.0.1:4390
SOCIAL_CONCIERGE_KEY=
SOCIAL_AGENT_KEY=
SOCIAL_VAULT_KEY=
SOCIAL_DB=
SOCIAL_BIND=127.0.0.1:4390
SOCIAL_META_GRAPH_VERSION=v24.0
SOCIAL_FACEBOOK_CLIENT_ID=
SOCIAL_FACEBOOK_CLIENT_SECRET=
SOCIAL_FACEBOOK_CALLBACK=
SOCIAL_INSTAGRAM_CLIENT_ID=
SOCIAL_INSTAGRAM_CLIENT_SECRET=
SOCIAL_INSTAGRAM_CALLBACK=
SOCIAL_LINKEDIN_CLIENT_ID=
SOCIAL_LINKEDIN_CLIENT_SECRET=
SOCIAL_LINKEDIN_CALLBACK=
SOCIAL_MASTODON_ORIGIN=
SOCIAL_MASTODON_CLIENT_ID=
SOCIAL_MASTODON_CLIENT_SECRET=
SOCIAL_MASTODON_CALLBACK=
SOCIAL_ENABLE_PUBLISH=false
SOCIAL_ENABLE_FACEBOOK_PUBLISH=false
SOCIAL_ENABLE_INSTAGRAM_PUBLISH=false
SOCIAL_ENABLE_LINKEDIN_PUBLISH=false
SOCIAL_ENABLE_MASTODON_PUBLISH=false
