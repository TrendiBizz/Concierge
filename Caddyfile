# {$DOMAIN} comes from the caddy service environment (see docker-compose.yml).
# Use DOMAIN=localhost for local testing (Caddy issues an internal certificate;
# run `docker compose exec caddy caddy trust` or accept the browser warning).
# For production, point these A records at your server:
#   api.example.com  crm.example.com  chat.example.com  status.example.com
# Caddy then obtains Let's Encrypt certificates automatically.

api.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8000
}

crm.{$DOMAIN} {
	reverse_proxy twenty:3000
}

chat.{$DOMAIN} {
	reverse_proxy chatwoot:3000
}

status.{$DOMAIN} {
	reverse_proxy uptime-kuma:3001
}
