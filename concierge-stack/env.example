# Copy to .env and fill in (set-key.sh does this for you). NEVER commit .env.
XAI_API_KEY=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-a-long-random-string-32-chars-min
BUSINESS_NAME=Trendi
# E.164 number a human answers, e.g. +6491234567. Empty = transfer disabled.
HUMAN_TRANSFER_NUMBER=
GROK_VOICE=Ara
# Where new-booking and new-message alerts go
OWNER_EMAIL=admin@trendibizz.com
# Speech-detection sensitivity, 0 to 1 (lower hears quieter speech; plugin default 0.5)
VAD_THRESHOLD=0.4
# Call transcripts (text only, saved in data/transcripts). TRANSCRIPTS=off disables them.
# Transcripts older than this many days are deleted at startup (0 = keep forever). 30 days, set by Jo.
TRANSCRIPTS=on
TRANSCRIPT_RETENTION_DAYS=30
# Safety: hang up any call longer than this many seconds
MAX_CALL_SECONDS=900

# Booking rules (days: Monday=0 ... Sunday=6)
BOOKING_TIMEZONE=Pacific/Auckland
BOOKING_OPEN=09:00
BOOKING_CLOSE=17:00
BOOKING_DAYS=0,1,2,3,4
BOOKING_SLOT_MINUTES=30
BOOKING_MIN_NOTICE_HOURS=2
BOOKING_HORIZON_DAYS=14

# Email (any SMTP provider). Leave empty and emails are only written to data/outbox.jsonl
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# CRM: every recorded call goes to the Twenty lead bridge. Empty = only written to data/outbox.jsonl
CRM_BRIDGE_URL=

# SMS. SMS_PROVIDER=mac sends from this Mac's Messages app (iPhone Text Message Forwarding).
# The terminal or app running the agent needs Full Disk Access to confirm a send, otherwise the
# result is 'unverified' (not sent). Seconds to wait for confirmation on a live call:
SMS_PROVIDER=
SMS_VERIFY_SECONDS=10
# Or Telnyx. Leave all empty and texts are only written to data/outbox.jsonl
TELNYX_API_KEY=
SMS_FROM=

# Ops tools (VPS later)
POSTGRES_PASSWORD=change-me
ACTIVEPIECES_ENCRYPTION_KEY=change-me-32-hex-chars
ACTIVEPIECES_JWT_SECRET=change-me
CHATWOOT_SECRET_KEY_BASE=change-me-long-random
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=change-me
