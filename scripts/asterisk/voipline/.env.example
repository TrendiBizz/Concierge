# VoipLine Telecom SIP trunk. Export these before running configure-voipline.py.
VOIPLINE_SIP_HOST=sip.voipline.co.nz
VOIPLINE_SIP_USER=your-sip-username
VOIPLINE_SIP_PASS=your-sip-password
VOIPLINE_DID=+6490000000
VOIPLINE_TENANT=pukeko-construction
VOIPLINE_BRIDGE_PORT=9512
# Optional: provider signalling source network, e.g. 203.0.113.10/32
VOIPLINE_SOURCE_CIDR=
