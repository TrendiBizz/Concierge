; --- VoipLine Telecom SIP trunk (registration) ---
; Rendered by configure-voipline.py. Do not edit the generated file by hand.
[voipline-registration]
type=registration
transport=transport-udp
outbound_auth=voipline-auth
server_uri=sip:{{SIP_HOST}}
client_uri=sip:{{SIP_USER}}@{{SIP_HOST}}
contact_user={{SIP_USER}}
retry_interval=60
forbidden_retry_interval=300
expiration=3600

[voipline-auth]
type=auth
auth_type=userpass
username={{SIP_USER}}
password={{SIP_PASS}}

[voipline-aor]
type=aor
contact=sip:{{SIP_HOST}}
qualify_frequency=30
max_contacts=1
remove_existing=yes

[voipline]
type=endpoint
transport=transport-udp
context=voipline-inbound
disallow=all
allow=ulaw,alaw
outbound_auth=voipline-auth
aors=voipline-aor
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
from_user={{SIP_USER}}
from_domain={{SIP_HOST}}
identify_by=username
