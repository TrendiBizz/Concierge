FROM python:3.12-slim
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 FASTEMBED_CACHE_PATH=/opt/fastembed HF_HUB_DISABLE_TELEMETRY=1 OMP_NUM_THREADS=1
WORKDIR /srv
COPY scripts/vps/api-requirements.lock ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
RUN python -c "from fastembed import TextEmbedding; TextEmbedding(model_name='BAAI/bge-small-en-v1.5', threads=1)"
COPY api/app ./app
COPY api/static ./static
RUN chmod -R a+rX /srv/app /srv/static && useradd --system --uid 10001 app && chown -R app /opt/fastembed
USER app
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
