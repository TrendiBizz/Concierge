{
    auto_https off
    admin off
}
:8080 {
    header X-Trendi-Release "20261108-vps"
    # Access log for the public website only, so crawl and bot visits can be measured (weekly SEO audit).
    # Other hosts carry tokens in their paths (quotes, invoices, uploads, unsubscribe), so they are not logged.
    # Query strings, cookies, auth headers and visitor IPs are removed before anything is written.
    log {
        output file /var/log/caddy/trendibizz-access.log {
            roll_size 50MiB
            roll_keep 5
        }
        format filter {
            wrap json
            request>uri regexp `[?].*$` ""
            request>headers>Cookie delete
            request>headers>Authorization delete
            request>headers>Cf-Connecting-Ip delete
            request>headers>X-Forwarded-For delete
            request>headers>Referer regexp `[?].*$` ""
            request>client_ip delete
            request>remote_ip delete
            resp_headers delete
        }
    }
    @notwebsite not host trendibizz.com
    log_skip @notwebsite
    encode gzip
    # The website's enquiry forms post to the API; everything else on the apex is the static site.
    @enquiry {
        host trendibizz.com
        path /api/enquiry
    }
    handle @enquiry {
        reverse_proxy api:8000 {
            lb_try_duration 10s
            lb_try_interval 250ms
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
        }
    }
    @website host trendibizz.com
    handle @website {
        @static path /brand/* /fonts/* /assets/* /images/*
        header @static Cache-Control "public, max-age=2592000, immutable"
        reverse_proxy website:8080
    }
    @www host www.trendibizz.com
    handle @www {
        redir https://trendibizz.com{uri} 301
    }
    @chat {
        host chat.trendibizz.com
        path /widget.js /demo/* /api/v1/widget-config /api/v1/widget-logo /api/v1/translate /api/v1/chat /api/v1/chat/stream /api/v1/voice/token /api/v1/voice/log /api/v1/voice/sessions/* /api/v1/voice/recordings/shared/* /api/v1/tools/* /api/v1/unsubscribe/* /api/v1/smsgate/* /api/v1/sms/*
    }
    handle @chat {
        reverse_proxy api:8000 {
            # A deploy recreates the api container and the container network's DNS briefly answers
            # SERVFAIL for "api"; without retries Caddy returned 502 and the phone
            # connector's SMS receipts were lost (2026-11-12 system check).
            lb_try_duration 10s
            lb_try_interval 250ms
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
        }
    }
    @owner {
        host concierge.trendibizz.com
        path / /favicon.ico /favicon.svg /webhooks/stripe /receipt/* /privacy /privacy/* /guide/* /owner-ui /onboarding /studio /studio/* /quote/* /invoice/* /upload/* /robots.txt /api/v1/public-design/* /owner/* /api/v1/calendar/*.ics /api/v1/inbound/cloudflare /webhooks/brevo /api/v1/social-media/* /api/v1/device-sms/* /api/v1/phone/xai/* /api/v1/voice/recordings/shared/* /api/v1/phone/managed/*
    }
    handle @owner {
        reverse_proxy api:8000 {
            # A deploy recreates the api container and the container network's DNS briefly answers
            # SERVFAIL for "api"; without retries Caddy returned 502 and the phone
            # connector's SMS receipts were lost (2026-11-12 system check).
            lb_try_duration 10s
            lb_try_interval 250ms
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
        }
    }
    @crm host crm.trendibizz.com
    handle @crm {
        reverse_proxy crm:3000 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
        }
    }
    respond 404
}
