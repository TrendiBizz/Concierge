# Concierge gateway (Rust): capability tokens, plan validation, orchestrated runs. Loopback only, non-root, read-only filesystem.
# The crate depends on concierge-core by path, so both crates are built from the repository root as context.
FROM rust:1.91-bookworm AS build
WORKDIR /build/concierge-stack
COPY concierge-stack/core-rs/Cargo.toml concierge-stack/core-rs/Cargo.lock core-rs/
COPY concierge-stack/core-rs/src core-rs/src
COPY concierge-stack/action-gateway/Cargo.toml concierge-stack/action-gateway/Cargo.lock action-gateway/
COPY concierge-stack/action-gateway/src action-gateway/src
WORKDIR /build/concierge-stack/action-gateway
RUN CARGO_BUILD_JOBS=1 cargo build --locked --release -j 1

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10003 --no-create-home actiongw
COPY --from=build /build/concierge-stack/action-gateway/target/release/action-gateway /usr/local/bin/action-gateway
USER actiongw
ENV ACTION_GATEWAY_BIND=127.0.0.1:4420
ENTRYPOINT ["/usr/local/bin/action-gateway"]
