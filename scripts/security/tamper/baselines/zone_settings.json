{
  "0rtt": "off",
  "always_online": "off",
  "always_use_https": "on",
  "automatic_https_rewrites": "on",
  "browser_cache_ttl": 0,
  "browser_check": "on",
  "cache_level": "aggressive",
  "development_mode": "off",
  "email_obfuscation": "off",
  "hotlink_protection": "off",
  "http3": "on",
  "ip_geolocation": "on",
  "min_tls_version": "1.2",
  "minify": {
    "css": "off",
    "html": "off",
    "js": "off"
  },
  "mirage": "off",
  "opportunistic_encryption": "on",
  "polish": "off",
  "rocket_loader": "off",
  "security_header": {
    "strict_transport_security": {
      "enabled": true,
      "include_subdomains": true,
      "max_age": 31536000,
      "nosniff": true,
      "preload": false
    }
  },
  "security_level": "medium",
  "server_side_exclude": "on",
  "ssl": "full",
  "tls_1_3": "on",
  "universal_ssl_enabled": true,
  "websockets": "on"
}
